@model PaginatedList<RecommendationLog>
@{ ViewData["Title"]="Jurnalul recomandărilor"; }
<h1>Jurnalul recomandărilor</h1>
<p>Datele sunt afișate și filtrate în UTC.</p>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="get" class="d-flex gap-2 mb-3 align-items-end">
<label>Cititor<input name="readerId" type="number" value="@ViewBag.ReaderId" class="form-control" /></label>
<label>De la<input name="from" type="date" value="@ViewBag.From" class="form-control" /></label>
<label>Până la<input name="to" type="date" value="@ViewBag.To" class="form-control" /></label>
<input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
<button class="btn btn-primary">Filtrează</button><a asp-action="Log">Resetează</a>
</form>
<table class="table"><thead><tr><th>Cititor</th><th><a asp-action="Log" asp-route-readerId="@ViewBag.ReaderId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sortOrder='@(ViewBag.SortOrder == "date" ? "date_desc" : "date")'>Data UTC ↕</a></th><th>ID-uri cărți (în ordinea recomandării)</th></tr></thead>
<tbody>@foreach(var row in Model) { <tr><td>@row.ReaderId</td><td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@row.BookIds</td></tr> }</tbody></table>
@if(Model.Count == 0) { <p>Nu există apeluri pentru filtrele selectate.</p> }
<p>@Model.TotalCount apeluri · Pagina @Model.PageIndex din @Model.TotalPages</p>
@if(Model.HasPreviousPage) { <a class="btn btn-outline-primary" asp-route-pageNumber="@(Model.PageIndex-1)" asp-route-readerId="@ViewBag.ReaderId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sortOrder="@ViewBag.SortOrder">Înapoi</a> }
@if(Model.HasNextPage) { <a class="btn btn-outline-primary" asp-route-pageNumber="@(Model.PageIndex+1)" asp-route-readerId="@ViewBag.ReaderId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sortOrder="@ViewBag.SortOrder">Înainte</a> }
