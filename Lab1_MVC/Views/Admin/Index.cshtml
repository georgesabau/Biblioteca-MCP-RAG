@{ ViewData["Title"] = "Administrare"; }
<h1>Administrare</h1>
@if (TempData["Msg"] is string msg) { <div class="alert alert-info" role="status">@msg</div> }
<p>Evaluări în baza de date: <strong>@ViewBag.Ratings</strong></p>
<form asp-action="ImportRatings" method="post" enctype="multipart/form-data" class="mb-4">
<label for="ratings">Evaluări CSV (UserId,BookId,Rating)</label>
<input id="ratings" type="file" name="file" accept=".csv" required />
<button class="btn btn-primary">Importă evaluări</button>
</form>

<form asp-action="Retrain" method="post"><button class="btn btn-warning">Reantrenează modelul de recomandare</button></form>

<p class="mt-3"><a asp-action="Log">Jurnalul recomandărilor</a> · <a asp-action="Dashboard">Dashboard</a></p>
